# ================================================================
# Pendrive_X — portable runtime configuration
# ================================================================
# Copy this file to `.env` on the USB root (installers do it for you)
# and edit with any text editor. Values are read at every launch.
# ================================================================

# Inference backend: ollama (default) or llamacpp (llama-server).
# llama.cpp avoids Ollama's background service and saves ~1.5-2 GB RAM.
INFERENCE_ENGINE=ollama

# 1 = auto-detect CUDA / ROCm / Vulkan / Metal and tune layer offload.
AUTO_TUNE=1

# 1 = bind the engine (and the optional mobile chat page) to the LAN.
# The --server / --lan command-line flag overrides this for one session.
SERVER_MODE=0

# Fixed ports (0 = automatically pick a free port).
OLLAMA_PORT=0
LLAMACPP_PORT=0
LAN_CHAT_PORT=8090

# Default quantization preference for model downloads (Q4_K_M, Q5_K_M, Q8_0, Q2_K)
MODEL_QUANT=Q4_K_M

# Local embedding model for AnythingLLM local RAG with Ollama
EMBEDDING_MODEL=nomic-embed-local

# -----------------------------------------------------------------
# llama.cpp tuning (llamacpp engine)
# -----------------------------------------------------------------
# Preferred model alias (from models/installed-models.txt). Empty = first.
LLAMACPP_MODEL=

# auto, or a number. auto uses VRAM / compute capability detection.
LLAMACPP_NGL=auto
LLAMACPP_THREADS=auto
LLAMACPP_CTX=auto

# Force a llama.cpp build: auto, cuda, rocm, vulkan, cpu.
LLAMACPP_VARIANT=auto

# Extra llama-server arguments, e.g. --flash-attn --no-mmap
LLAMACPP_EXTRA_ARGS=

# -----------------------------------------------------------------
# Ollama tuning
# -----------------------------------------------------------------
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1
