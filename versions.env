# Pendrive_X — Pinned versions (reproducible installs)
# Update these to bump Ollama / AnythingLLM / llama.cpp. Use --latest flag to ignore pins.

OLLAMA_VERSION=0.6.8
OLLAMA_WIN_URL=https://github.com/ollama/ollama/releases/download/v0.6.8/ollama-windows-amd64.zip
OLLAMA_LINUX_URL=https://github.com/ollama/ollama/releases/download/v0.6.8/ollama-linux-amd64.tgz
# Fallback alt URL (tar.zst) if tgz missing on mirror:
OLLAMA_LINUX_ALT_URL=https://ollama.com/download/ollama-linux-amd64.tar.zst
OLLAMA_MAC_URL=https://github.com/ollama/ollama/releases/download/v0.6.8/ollama-darwin.zip

ANYTHINGLLM_VERSION=1.7.5
ANYTHINGLLM_WIN_URL=https://cdn.anythingllm.com/latest/AnythingLLMDesktop.exe
ANYTHINGLLM_LINUX_URL=https://cdn.anythingllm.com/latest/AnythingLLMDesktop.AppImage
ANYTHINGLLM_MAC_URL=https://cdn.anythingllm.com/latest/AnythingLLMDesktop-Silicon.dmg
ANYTHINGLLM_MAC_INTEL_URL=https://cdn.anythingllm.com/latest/AnythingLLMDesktop.dmg

# -----------------------------------------------------------------
# llama.cpp / llama-server (standalone portable builds)
# -----------------------------------------------------------------
# Pinned GitHub release. Asset names are derived from this tag by the
# install/update scripts; override any URL below to pin a mirror.
LLAMACPP_VERSION=b12244

# Windows — Vulkan is the safe default for NVIDIA + AMD + Intel.
LLAMACPP_WIN_URL=https://github.com/ggml-org/llama.cpp/releases/download/b12244/llama-b12244-bin-win-vulkan-x64.zip
LLAMACPP_WIN_VULKAN_URL=https://github.com/ggml-org/llama.cpp/releases/download/b12244/llama-b12244-bin-win-vulkan-x64.zip
LLAMACPP_WIN_CPU_URL=https://github.com/ggml-org/llama.cpp/releases/download/b12244/llama-b12244-bin-win-cpu-x64.zip
LLAMACPP_WIN_CUDA_URL=https://github.com/ggml-org/llama.cpp/releases/download/b12244/llama-b12244-bin-win-cuda-12.4-x64.zip
LLAMACPP_WIN_CUDA_RUNTIME_URL=https://github.com/ggml-org/llama.cpp/releases/download/b12244/cudart-llama-bin-win-cuda-12.4-x64.zip

# Linux — CPU default; GPU variants selected by hardware auto-tuning.
LLAMACPP_LINUX_URL=https://github.com/ggml-org/llama.cpp/releases/download/b12244/llama-b12244-bin-ubuntu-x64.tar.gz
LLAMACPP_LINUX_VULKAN_URL=https://github.com/ggml-org/llama.cpp/releases/download/b12244/llama-b12244-bin-ubuntu-vulkan-x64.tar.gz
LLAMACPP_LINUX_CUDA_URL=https://github.com/ggml-org/llama.cpp/releases/download/b12244/llama-b12244-bin-ubuntu-cuda-12.8-x64.tar.gz
LLAMACPP_LINUX_CUDA_RUNTIME_URL=https://github.com/ggml-org/llama.cpp/releases/download/b12244/cudart-llama-b12244-bin-ubuntu-cuda-12.8-x64.tar.gz
LLAMACPP_LINUX_ROCM_URL=https://github.com/ggml-org/llama.cpp/releases/download/b12244/llama-b12244-bin-ubuntu-rocm-10.0-x64.tar.gz

# macOS — Metal is used automatically by the arm64/x64 builds.
LLAMACPP_MAC_ARM_URL=https://github.com/ggml-org/llama.cpp/releases/download/b12244/llama-b12244-bin-macos-arm64.tar.gz
LLAMACPP_MAC_X64_URL=https://github.com/ggml-org/llama.cpp/releases/download/b12244/llama-b12244-bin-macos-x64.tar.gz
